{
  "name": "game-creator-chatbot",
  "version": "1.0.0",
  "description": "A chatbot backed by cooperating agents that designs and builds complete web games.",
  "private": true,
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "test": "node test/run.js",
    "test:e2e": "playwright test",
    "test:e2e:flappy": "playwright test -g \"Flappy Bird\"",
    "test:e2e:snake": "playwright test -g \"Snake and ladder\"",
    "test:e2e:collect": "playwright test -g \"Collect & Dodge\"",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
