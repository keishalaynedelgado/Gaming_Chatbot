# Copy this file to .env and fill in your key(s).

# Required. Every chat, message, and generated game (every version's files)
# is stored in this PostgreSQL database -- see backend/src/services/db.js
# and store.js. The server creates its own tables on startup (CREATE TABLE
# IF NOT EXISTS); it does not create the database or role itself.
DATABASE_URL=postgres://gamechatbot:CHANGE_ME@127.0.0.1:5432/gamechatbot

# MELDCX is the primary provider and is always tried first.
MELDCX_API_KEY=
MELDCX_BASE_URL=http://10.11.0.4:1234/v1
# MELDCX_MODEL=              # optional: overrides the default model for every role below

# SCX is an automatic fallback, used only if MELDCX is missing, invalid,
# unavailable, or fails to connect. Optional -- leave SCX_API_KEY blank to
# disable the fallback (a MELDCX failure will then just error out as before).
# SCX_API_KEY=
# SCX_BASE_URL=https://api.scx.ai/v1
# SCX_MODEL=MiniMax-M2.7

# Optional
# PORT=3000
# HOST=0.0.0.0   (listen on the local network, e.g. for phones via QR code)
# INTENT_MODEL=gpt-oss-120b
# DESIGNER_MODEL=gpt-oss-120b
# BUILDER_MODEL=minimax-m2.7
# QA_MODEL=gpt-oss-120b
# QA_REVIEW=1            # off by default for speed (one-pass generation); set to 1 for
                          # an extra full LLM review pass after building (static checks +
                          # the automatic repair loop always run either way)
# EXPORT_TOOLS_DIR=E:\DevTools   # enables "Export app" (Android APK / Windows EXE / Setup). The folder holds:
                                  #   jdk-17\       Java 17 (Microsoft Build of OpenJDK, portable zip)
                                  #   android-sdk\  platforms;android-34 + build-tools;34.0.0 (via sdkmanager)
                                  #   webview2\     the Microsoft.Web.WebView2 NuGet package, unzipped
                                  #   wix\          WiX Toolset 3.14 binaries (wix314-binaries.zip), for the Setup
                                  # App icons are rendered with Microsoft Edge (EXPORT_EDGE_PATH to override).
                                  # Each can instead be set on its own: EXPORT_JAVA_HOME, ANDROID_HOME,
                                  # EXPORT_WEBVIEW2_DIR, EXPORT_WIX_DIR. The EXE is compiled with Windows' own csc.exe.

# Optional: centralized logging. When GRAYLOG_HOST is set, every log entry is
# also sent to Graylog as GELF over UDP (console output is unchanged). Needs a
# "GELF UDP" input in Graylog on this port. API keys, passwords, tokens and
# chat/prompt content are never sent -- see backend/src/utils/logger.js.
# GRAYLOG_HOST=127.0.0.1
# GRAYLOG_PORT=12201
